{
  "name": "switchin",
  "version": "0.0.0",
  "private": true,
  "description": "SwitchIn - AI Workforce & Collaboration Platform - microservices monorepo",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm run build",
    "lint": "eslint .",
    "test": "pnpm run build && vitest run",
    "bundle:remote-runtimes": "pnpm --filter \"./providers/*\" run bundle:remote"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0",
    "vitest": "^2.1.4"
  }
}
